<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/violet</item>
        <item name="android:colorPrimaryDark">@color/canvas</item>
        <item name="android:colorAccent">@color/violet</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorControlActivated">@color/violet</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <!-- 启动页：背景由自绘极光负责，主题只保证不闪白 -->
    <style name="SplashTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- 页面切换：上滑 + 淡入 -->
    <style name="Anim.Page" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_in</item>
        <item name="android:activityOpenExitAnimation">@anim/page_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/page_out</item>
    </style>

    <style name="T" />
    <style name="Btn" />

    <!-- 字阶：Display 38 / H1 27 / Title 17 / Body 15 / Meta 12.5 / Num 40 -->
    <style name="T.Display">
        <item name="android:textSize">38sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:lineSpacingMultiplier">1.06</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="T.H1">
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.14</item>
    </style>

    <style name="T.Title">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.28</item>
    </style>

    <style name="T.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="T.Meta">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- 小标签：全大写 + 字距，做分区标题用 -->
    <style name="T.Label">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="T.Num">
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 主按钮：极光渐变胶囊 -->
    <style name="Btn.Pill">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Btn.PillGhost">
        <item name="android:background">@drawable/bg_pill_ghost</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 玻璃卡：白色半透明 + 发丝白边 + 柔和投影 -->
    <style name="GlassCard">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:elevation">3dp</item>
    </style>

    <style name="Switch.Aurora" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>
</resources>
