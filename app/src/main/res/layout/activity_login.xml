<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.keepup.course.AuroraView
        android:id="@+id/aurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp">

        <TextView
            style="@style/T.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT" />

        <TextView
            android:id="@+id/tvLoginTitle"
            style="@style/T.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/login_title" />

        <TextView
            style="@style/T.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/login_tip" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:padding="6dp">

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_web_round"
                android:clipToOutline="true" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="18dp">

            <View
                android:layout_width="200dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glow" />

            <Button
                android:id="@+id/btnDone"
                style="@style/Btn.Pill"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/login_done" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
