<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.keepup.course.AuroraView
        android:id="@+id/aurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btnBackSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_ghost"
                android:contentDescription="返回"
                android:padding="9dp"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/T.H1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title" />

            <Button
                android:id="@+id/btnSave"
                style="@style/Btn.Pill"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@null"
                android:text="@string/save"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="34dp">

                <TextView
                    style="@style/T.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="9dp"
                    android:text="REMINDERS · 提醒" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <TextView
                            style="@style/T.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="提前 24 小时提醒" />

                        <Switch
                            android:id="@+id/cb24"
                            style="@style/Switch.Aurora"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <TextView
                            style="@style/T.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="提前 2 小时提醒" />

                        <Switch
                            android:id="@+id/cb2"
                            style="@style/Switch.Aurora"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <TextView
                            style="@style/T.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="截止那一刻提醒" />

                        <Switch
                            android:id="@+id/cb0"
                            style="@style/Switch.Aurora"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <TextView
                            style="@style/T.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="列表里显示已完成作业" />

                        <Switch
                            android:id="@+id/cbShowDone"
                            style="@style/Switch.Aurora"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>


                <TextView
                    style="@style/T.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="9dp"
                    android:text="INTERVAL · 后台检查" />

                <RadioGroup
                    android:id="@+id/rgInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <RadioButton
                        android:id="@+id/rb15"
                        style="@style/T.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="@string/interval_15" />

                    <RadioButton
                        android:id="@+id/rb30"
                        style="@style/T.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="@string/interval_30" />

                    <RadioButton
                        android:id="@+id/rb60"
                        style="@style/T.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="@string/interval_60" />
                </RadioGroup>

                <TextView
                    style="@style/T.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="9dp"
                    android:text="AI · 解题助手" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <RadioGroup
                        android:id="@+id/rgAiMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbFree"
                            style="@style/T.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:text="免费通道（不用 Key，慢一些）" />

                        <RadioButton
                            android:id="@+id/rbCustom"
                            style="@style/T.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:text="自备接口（更快更准）" />
                    </RadioGroup>

                    <EditText
                        android:id="@+id/etAiBase"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:hint="接口地址，如 https://api.deepseek.com/v1"
                        android:inputType="textUri"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_3"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etAiKey"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:hint="API Key（sk-...）"
                        android:inputType="textPassword"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_3"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etAiModel"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:hint="模型名，如 deepseek-chat"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_3"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/T.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="填完自动提交（不建议）" />

                        <Switch
                            android:id="@+id/cbAutoSubmit"
                            style="@style/Switch.Aurora"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTestAi"
                        style="@style/Btn.PillGhost"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:text="测试连接" />
                </LinearLayout>
                <TextView
                    android:id="@+id/btnAgreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="用户协议与隐私说明"
                    android:textColor="@color/ink_2"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnClear"
                    style="@style/Btn.PillGhost"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/clear_account"
                    android:textColor="@color/coral" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
